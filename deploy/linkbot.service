[Unit]
Description=Telegram link-list cleaner bot (linkbot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nastya-bot
ExecStart=/opt/nastya-bot/.venv/bin/python -m linkbot.bot
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
