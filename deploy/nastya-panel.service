[Unit]
Description=Nastya admin panel bot (общая ОП для всех ботов)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nastya-bot
ExecStart=/opt/nastya-bot/.venv/bin/python -m panel.main
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
