# ── Телеграм ───────────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456:AA...
# Твой chat_id (узнать у @userinfobot). Сюда падают заявки на вывод.
ADMIN_CHAT_ID=123456789
# Дополнительные админы через запятую (необязательно)
ADMIN_IDS=

# ── Мини-апп ───────────────────────────────────────────────────────────
# Публичный HTTPS-адрес сервера. Именно он открывается как WebApp.
# Telegram требует HTTPS — локально удобно пробрасывать через ngrok/cloudflared.
PUBLIC_BASE_URL=https://example.com
# Порт локального HTTP-сервера (за nginx). Должен быть свободен:
# если на сервере уже крутятся другие боты, возьми свой (8082 и т.п.)
PORT=8080

# Название платформы (видно в шапке мини-аппа)
BRAND_NAME=JOWS
BRAND_TAGLINE=платформа заданий

# ── Экономика ──────────────────────────────────────────────────────────
# Минимальная сумма вывода, ₽
MIN_WITHDRAW=500
# «Участников» на главной = реальные пользователи + это число (витрина)
PARTICIPANTS_BASE=7000
# Автоматически начислять баланс сразу после отправки задания.
# 0 — задания уходят на модерацию админу.
AUTOAPPROVE=1

# Писать ли админу о каждой заявке на вывод. По умолчанию нет: постоянные
# участники выводят раз за разом, и уведомление перестаёт что-либо значить.
# Приходят только те, где человек подписался ради этой заявки — впервые
# или вернувшись после ухода, — и те, где с подпиской что-то не так.
# Остальные заявки никуда не деваются, их видно в /wd и /stats.
NOTIFY_ALL_WITHDRAWALS=0

# Писать ли админу о каждом выполненном задании. По умолчанию нет —
# иначе при живом трафике это сплошной поток сообщений. Ответы, которые
# ждут модерации (AUTOAPPROVE=0), приходят в любом случае.
NOTIFY_SUBMISSIONS=0

# Спрашивать подписку на каналы партнёров только перед ПЕРВЫМ выводом.
# Экран перед списком каналов обещает именно это, так что при 0 текст
# обещает больше, чем приложение делает: подписка будет проверяться
# перед каждой заявкой.
PAYOUT_GATE_FIRST_ONLY=0

# Демо-режим выплат ДЛЯ АДМИНИСТРАТОРА: его заявка на вывод сразу
# помечается доставленной, чтобы показать заказчику, как выглядит
# успешная выплата. На обычных участников не влияет — у них заявка
# уходит на обработку как обычно. 0 — выключить и для админа.
DEMO_PAYOUT_FOR_ADMIN=1

# Как администратор подписан в приложении при показе заказчику.
# Пусто — берём настоящие имя и фото из Telegram.
DEMO_ADMIN_NAME=Мария
# Аватар: эмодзи (например 👩) или прямая ссылка на картинку (https://...)
DEMO_ADMIN_AVATAR=

# ── Общее состояние подписки ───────────────────────────────────────────
# Один файл на все боты и панель: кто в него пишет — меняет списки везде.
OP_STATE_FILE=op_state.json
# Отдельный бот-панель (свой токен от @BotFather). Пусто — панель не нужна.
PANEL_BOT_TOKEN=

# ── Прочее ─────────────────────────────────────────────────────────────
DB_PATH=jows.db
SUPPORT_USERNAME=@support
# Режим разработки: 1 — открывать веб-апп в браузере без подписи Telegram
WEBAPP_DEV=0
