[Unit]
Description=VOXY admin panel bot
# Токены и порт — в /opt/voxy/miniapp/.env
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voxy
WorkingDirectory=/opt/voxy/miniapp
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/voxy/miniapp/.venv/bin/python -m panel.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
