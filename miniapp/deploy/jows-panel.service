[Unit]
Description=JOWS admin panel bot
# Токены и порт — в /opt/jows/miniapp/.env
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jows
WorkingDirectory=/opt/jows/miniapp
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/jows/miniapp/.venv/bin/python -m panel.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
