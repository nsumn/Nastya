art": 31.266, "end": 31.394}, {"word": "줘.", "start": 31.452, "end": 31.882}, {"word": "오늘", "start": 32.346, "end": 32.59}, {"word": "팔로우하면,", "start": 32.636, "end": 33.519}, {"word": "내일", "start": 33.681, "end": 33.983}, {"word": "네", "start": 34.006, "end": 34.087}, {"word": "이름이", "start": 34.157, "end": 34.61}, {"word": "내", "start": 34.796, "end": 34.958}, {"word": "박스에", "start": 35.016, "end": 35.388}, {"word": "적혀", "start": 35.446, "end": 35.748}, {"word": "있을", "start": 35.794, "end": 36.05}, {"word": "거야.", "start": 36.108, "end": 36.56}, {"word": "내일", "start": 36.967, "end": 37.176}, {"word": "아침까지", "start": 37.234, "end": 37.71}, {"word": "몇", "start": 37.756, "end": 37.896}, {"word": "마리", "start": 37.942, "end": 38.139}, {"word": "모일까?", "start": 38.186, "end": 38.848}, {"word": "2편에서", "start": 39.138, "end": 39.683}, {"word": "알려", "start": 39.742, "end": 39.939}, {"word": "줄게.", "start": 39.985, "end": 40.682}], "cues": [{"start": 0.0, "end": 1.602, "text": "안녕, 나는 키키야."}, {"start": 1.707, "end": 3.17, "text": "편의점 앞 박스에 살아."}, {"start": 3.634, "end": 6.618, "text": "근데 사장님이 내일 아침에 이 박스를 버린대."}, {"start": 6.966, "end": 8.522, "text": "그래서 부탁이 하나 있어."}, {"start": 8.684, "end": 10.96, "text": "팔로우 한 명은 아기 고양이 한 마리."}, {"start": 11.25, "end": 12.55, "text": "내 옆으로 이사 와."}, {"start": 12.806, "end": 16.498, "text": "열 마리가 모이면, 우리가 같이 박스를 지킬 수 있어."}, {"start": 16.789, "end": 19.296, "text": "서른 마리면, 진짜 집을 지을 거야."}, {"start": 19.842, "end": 22.686, "text": "그리고 너희 고양이 사진을 댓글에 보내 줘."}, {"start": 23.429, "end": 26.344, "text": "그 고양이가 다음 편에 우리 골목으로 이사 와."}, {"start": 26.75, "end": 28.166, "text": "이름표도 달아 줄게."}, {"start": 28.712, "end": 31.882, "text": "사진이 없으면, 원하는 고양이 모습을 써 줘."}, {"start": 32.346, "end": 36.56, "text": "오늘 팔로우하면, 내일 네 이름이 내 박스에 적혀 있을 거야."}, {"start": 36.967, "end": 38.848, "text": "내일 아침까지 몇 마리 모일까?"}, {"start": 39.138, "end": 40.682, "text": "2편에서 알려 줄게."}], "segments": [{"index": 1, "kind": "chunk", "text": "안녕, 나는 키키야. 편의점 앞 박스에 살아.\n근데 사장님이 내일 아침에 이 박스를 버린대.\n그래서 부탁이 하나 있어.\n팔로우 한 명은 아기 고양이 한 마리. 내 옆으로 이사 와.\n열 마리가 모이면, 우리가 같이 박스를 지킬 수 있어. 서른 마리면, 진짜 집을 지을 거야.\n그리고 너희 고양이 사진을 댓글에 보내 줘.\n그 고양이가 다음 편에 우리 골목으로 이사 와. 이름표도 달아 줄게.\n사진이 없으면, 원하는 고양이 모습을 써 줘.\n오늘 팔로우하면, 내일 네 이름이 내 박스에 적혀 있을 거야.\n내일 아침까지 몇 마리 모일까? 2편에서 알려 줄게.", "audio_file": null, "time_offset_seconds": 0.0, "duration_seconds": 40.682, "alignment": {"characters": ["안", "녕", ",", " ", "나", "는", " ", "키", "키", "야", ".", " ", "편", "의", "점", " ", "앞", " ", "박", "스", "에", " ", "살", "아", ".", "\n", "근", "데", " ", "사", "장", "님", "이", " ", "내", "일", " ", "아", "침", "에", " ", "이", " ", "박", "스", "를", " ", "버", "린", "대", ".", "\n", "그", "래", "서", " ", "부", "탁", "이", " ", "하", "나", " ", "있", "어", ".", "\n", "팔", "로", "우", " ", "한", " ", "명", "은", " ", "아", "기", " ", "고", "양", "이", " ", "한", " ", "마", "리", ".", " ", "내", " ", "옆", "으", "로", " ", "이", "사", " ", "와", ".", "\n", "열", " ", "마", "리", "가", " ", "모", "이", "면", ",", " ", "우", "리", "가", " ", "같", "이", " ", "박", "스", "를", " ", "지", "킬", " ", "수", " ", "있", "어", ".", " ", "서", "른", " ", "마", "리", "면", ",", " ", "진", "짜", " ", "집", "을", " ", "지", "을", " ", "거", "야", ".", "\n", "그", "리", "고", " ", "너", "희", " ", "고", "양", "이", " ", "사", "진", "을", " ", "댓", "글", "에", " ", "보", "내", " ", "줘", ".", "\n", "그", " ", "고", "양", "이", "가", " ", "다", "음", " ", "편", "에", " ", "우", "리", " ", "골", "목", "으", "로", " ", "이", "사", " ", "와", ".", " ", "이", "름", "표", "도", " ", "달", "아", " ", "줄", "게", ".", "\n", "사", "진", "이", " ", "없", "으", "면", ",", " ", "원", "하", "는", " ", "고", "양", "이", " ", "모", "습", "을", " ", "써", " ", "줘", ".", "\n", "오", "늘", " ", "팔", "로", "우", "하", "면", ",", " ", "내", "일", " ", "네", " ", "이", "름", "이", " ", "내", " ", "박", "스", "에", " ", "적", "혀", " ", "있", "을", " ", "거", "야", ".", "\n", "내", "일", " ", "아", "침", "까", "지", " ", "몇", " ", "마", "리", " ", "모", "일", "까", "?", " ", "2", "편", "에", "서", " ", "알", "려", " ", "줄", "게", "."], "character_start_times_seconds": [0.0, 0.163, 0.406, 0