# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администратора (необязательно). Узнать можно у @userinfobot.
ADMIN_CHAT_ID=

# ===== Магазин сборников =====
# Чат админа, который обрабатывает покупки сборников (ему приходят чеки,
# он отвечает покупателю и присылает файл). Может отличаться от ADMIN_CHAT_ID.
# Если оставить пустым — используется ADMIN_CHAT_ID.
SHOP_ADMIN_CHAT_ID=

# Реквизиты для оплаты картой РФ — показываются покупателю.
# Можно несколько строк в одну (используй \n) или просто номер карты/телефон СБП.
CARD_DETAILS=Карта 0000 0000 0000 0000 (Банк), получатель Имя Ф.

# ===== Хранилище =====
# Путь к файлу базы SQLite (подписчики).
DB_PATH=oge_bot.db

# ===== Ежедневная рассылка =====
# Включить ежедневную рассылку "материал дня": 1 — да, 0 — нет.
DAILY_ENABLED=1

# Время ежедневной рассылки по локальному времени сервера, формат ЧЧ:ММ.
DAILY_SEND_TIME=10:00
