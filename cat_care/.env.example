# ===== Telegram =====
# Токен НОВОГО бота от @BotFather (не платёжного!)
BOT_TOKEN=123456:ABC-DEF...

# Публичный HTTPS-адрес мини-приложения (без слэша в конце).
# Например https://203-0-113-5.sslip.io  — см. deploy/DEPLOY.md
WEBAPP_URL=https://203-0-113-5.sslip.io

# Кто может пользоваться (через запятую, chat_id из @userinfobot).
# Пусто — пускает всех, кто откроет бота.
ALLOWED_USER_IDS=

# ===== Время =====
# Часовой пояс семьи
TIMEZONE=Europe/Moscow
# Последнее напоминание, которое нельзя отключить (если что-то не сделано).
# Утро/день/вечер каждый настраивает себе сам в чате бота: «🔔 Напоминания».
FORCED_REMINDER_TIME=23:00

# ===== Сервер =====
HOST=127.0.0.1
PORT=8090
DB_PATH=cats.db

# 1 = можно открыть приложение в обычном браузере без Telegram (для проверки)
DEV_MODE=0
