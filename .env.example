# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID чата администратора (твой личный chat_id), куда прилетают чеки
# и где ты ведёшь переписку с покупателями. Узнать можно у @userinfobot.
ADMIN_CHAT_ID=123456789

# ===== Platega.io (оплата по СБП) =====
# Данные из личного кабинета Platega
PLATEGA_MERCHANT_ID=your-merchant-id
PLATEGA_SECRET=your-secret-key
# Базовый URL API (по умолчанию боевой)
PLATEGA_BASE_URL=https://app.platega.io
# Метод оплаты в Platega: 2 = СБП (QR)
PLATEGA_SBP_METHOD=2

# Публичный адрес, на котором бот принимает вебхук от Platega.
# Например https://your-domain.com  (без слэша в конце).
# В Platega в качестве callback укажи  <PUBLIC_BASE_URL>/platega/callback
# Если пусто — статус всё равно подтвердится через polling.
PUBLIC_BASE_URL=

# Куда вернуть пользователя из браузера после оплаты (можно ссылку на бота)
RETURN_URL=https://t.me/your_bot
FAILED_URL=https://t.me/your_bot

# Порт локального веб-сервера для приёма вебхуков Platega
PORT=8080

# ===== Контент / ссылки =====
# Ссылка на канал, которую бот выдаёт ПОСЛЕ успешной оплаты по СБП
CHANNEL_LINK=https://t.me/+your_private_channel
# Канал, который выдаётся ПОСЛЕ оплаты Telegram Stars
STARS_LINK=https://t.me/your_stars_channel
# Цена доступа в звёздах (⭐). 0 = оплата звёздами выключена
STARS_PRICE=0
# ID каналов для одноразовых ссылок (бот должен быть админом канала).
# Узнать ID: переслать пост из канала боту в личку. Пусто/0 — выдаётся обычная ссылка.
CHANNEL_ID=0
STARS_CHANNEL_ID=0
# Тестовая цена в звёздах для одного аккаунта (для проверки оплаты)
TEST_USER_ID=0
TEST_STARS_PRICE=1
# Реферальная ссылка «купить звёзды выгодно» (показывается в оплате звёздами)
BUY_STARS_LINK=https://buyns.t.me/?start=ref-9ahrunie2par
# Ссылка на отзывы (кнопка в приветствии). Пусто — кнопки не будет.
REVIEWS_LINK=
# Ссылка/юзернейм администрации (кнопка в приветствии). Пусто — кнопки не будет.
ADMIN_LINK=

# Реквизиты для оплаты по карте РФ (показываются пользователю)
CARD_DETAILS=Номер карты: 0000 0000 0000 0000\nБанк: Сбербанк\nПолучатель: Иван И.

# ===== Контакты / FAQ (кнопка «❗️ Контакты/FAQ» снизу) =====
# Юзернейм поддержки
SUPPORT_USERNAME=@shewmilka
# Ссылки на политику конфиденциальности и пользовательское соглашение
PRIVACY_URL=https://telegra.ph/Politika-konfidencialnosti-04-01-26
TERMS_URL=https://telegra.ph/Polzovatelskoe-soglashenie-04-01-19

# Путь к файлу базы данных
DB_PATH=bot.db

# ===== Автопостинг из чужого канала в свой (без пометки «Переслано») =====
# 1 = включить. Бот ДОЛЖЕН быть админом и в канале-источнике, и в своём канале.
# Если админом в чужой канал добавить нельзя — используй tools/userbot_mirror.py
# (работает от личного аккаунта, достаточно быть подписанным на канал).
MIRROR_ENABLED=0
# Откуда копировать: numeric id каналов через запятую (узнать — переслать
# боту в личку любой пост из канала, он ответит его ID).
MIRROR_SOURCES=
# Куда публиковать: id своих каналов через запятую.
MIRROR_TARGETS=
# Задержка перед публикацией, секунды (0 = сразу). Например 120 — чтобы
# посты не появлялись секунда в секунду с источником.
MIRROR_DELAY=0
# Вырезать из текста чужие t.me-ссылки и @юзернеймы
MIRROR_REMOVE_LINKS=1
# Своя подпись в конце каждого поста (\n = перенос строки). Пусто — без подписи.
MIRROR_FOOTER=
# Замены в тексте: «старое=>новое», несколько через точку с запятой
MIRROR_REPLACE=
# Не копировать посты с этими словами (через запятую)
MIRROR_SKIP=
# 1 = копировать только посты с фото/видео/файлами
MIRROR_ONLY_MEDIA=0
# 1 = когда пост правят в источнике, править и копию
MIRROR_SYNC_EDITS=1

# ----- Зеркало от личного аккаунта (tools/userbot_mirror.py) -----
# Нужно, когда бота нельзя добавить админом в чужой канал.
# Получить на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Имя файла сессии (создаётся при первом входе)
TG_SESSION=mirror
# Файл памяти «что уже скопировано»
MIRROR_STATE=mirror_state.json
